{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Thin Worker + ASSETS for Almost Christmas. Local dev and dry-run only — no
  // custom domain routes until Infra preview after Armand-go (Production UIT).
  //
  // Layout: GitHub Pages serves the repository root. Wrangler uploads that same
  // root (`assets.directory`) with `run_worker_first` so every request hits the
  // Worker for Observability, then static files via env.ASSETS.fetch.
  // `.assetsignore` drops repo metadata from the asset upload.
  //
  // TODO(deploy): when going live on almost-xmas.soholocal.nl, confirm canonical,
  // hreflang, og:url, and og:image in index.html match the real hostname (Worker
  // rewrite to request origin is optional if HTML still has stale absolute URLs).
  "name": "xmas-countdown",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
